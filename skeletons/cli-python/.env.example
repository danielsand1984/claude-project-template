# Env vars for {{PROJECT_NAME}}.
# Copy to .env and fill in. .env is gitignored.

# === Connection target =================================================
# (Adjust to match what your CLI actually connects to.)
# DATABASE_URL=postgres://user:pass@host:5432/dbname    # if your CLI hits Postgres
# MSSQL_CONNECTION_STRING=                              # if your CLI hits SQL Server

# === External APIs =====================================================
# ANTHROPIC_API_KEY=                                    # required if you use Claude

# === Behavior ==========================================================
LOG_LEVEL=info                         # debug | info | warn | error
# OUTPUT_DIR=./outputs                 # default ./outputs
