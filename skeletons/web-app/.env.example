# Root .env.example for the web-app skeleton.
# Copy to .env (or .env.local) and fill in values. .env is gitignored.

# === Local infrastructure (docker compose) =============================
# These match docker-compose.yml; only change if you point at managed services.
DATABASE_URL=postgres://{{PROJECT_NAME}}:{{PROJECT_NAME}}@localhost:5432/{{PROJECT_NAME}}    # required
REDIS_URL=redis://localhost:6379                                                              # required

# === API service =======================================================
PORT=3000                              # default 3000
NODE_ENV=development                   # development | production
LOG_LEVEL=info                         # debug | info | warn | error

# === Auth ==============================================================
AUTH_MODE=dev                          # required: dev | oidc — service refuses to start if unset
ALLOW_DEV_AUTH=true                    # required in dev: enables `Bearer dev-admin` / `dev-member` tokens.
                                       # NEVER set this in production — devCredentialsProvider refuses
                                       # if NODE_ENV=production OR ALLOW_DEV_AUTH != "true".
# When AUTH_MODE=oidc, fill these:
OIDC_ISSUER_URL=                       # optional, required if AUTH_MODE=oidc
OIDC_CLIENT_ID=                        # optional, required if AUTH_MODE=oidc
OIDC_CLIENT_SECRET=                    # optional, required if AUTH_MODE=oidc
JWT_PUBLIC_KEY=                        # optional, for JWT signature verification

# === Multi-tenancy =====================================================
# Matches the org id created by ops/infra/db/seed.mjs. Use as X-Org-Id header
# in dev requests together with `Authorization: Bearer dev-admin` (or dev-member).
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000010   # dev org from seed.mjs

# === External services =================================================
ANTHROPIC_API_KEY=                     # required if you use Claude
# OPENAI_API_KEY=                      # uncomment if needed
# RESEND_API_KEY=                      # uncomment for email

# === Frontend ==========================================================
NEXT_PUBLIC_API_URL=http://localhost:3000   # required; web-portal reads this
NEXT_TELEMETRY_DISABLED=1                   # default 1

# === Reverse proxy =====================================================
# Required when running behind any reverse proxy / load balancer / k8s ingress.
# Number of proxy hops in front of the API. Without this, req.ip resolves to
# the proxy IP and rate limiting collapses into one shared bucket for all traffic.
TRUST_PROXY_HOPS=1                     # 1 for typical docker-compose / single ingress

# === Rate limiting =====================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100     # default 100; set higher for staging/prod
RATE_LIMIT_BURST=20                    # default 20

# === CORS ==============================================================
# DO NOT use `*` if you serve authenticated cookie-based responses.
# The middleware refuses to set Access-Control-Allow-Credentials when CORS_ORIGINS is `*`.
CORS_ORIGINS=http://localhost:3002     # comma-separated list of allowed origins
