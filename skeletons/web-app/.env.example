# Root .env.example for the web-app skeleton.
# Copy to .env (or .env.local) and fill in values. .env is gitignored.

# === Local infrastructure (docker compose) =============================
# These match docker-compose.yml; only change if you point at managed services.
DATABASE_URL=postgres://{{PROJECT_NAME}}:{{PROJECT_NAME}}@localhost:5432/{{PROJECT_NAME}}    # required
REDIS_URL=redis://localhost:6379                                                              # required

# === API service =======================================================
PORT=3000                              # default 3000
NODE_ENV=development                   # development | production
LOG_LEVEL=info                         # debug | info | warn | error

# === Auth ==============================================================
AUTH_MODE=dev                          # dev (credentials provider) | oidc (Keycloak/Entra/Google)
# When AUTH_MODE=oidc, fill these:
OIDC_ISSUER_URL=                       # optional, required if AUTH_MODE=oidc
OIDC_CLIENT_ID=                        # optional, required if AUTH_MODE=oidc
OIDC_CLIENT_SECRET=                    # optional, required if AUTH_MODE=oidc
JWT_PUBLIC_KEY=                        # optional, for JWT signature verification

# === Multi-tenancy =====================================================
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001   # optional, for dev-mode seed user

# === External services =================================================
ANTHROPIC_API_KEY=                     # required if you use Claude
# OPENAI_API_KEY=                      # uncomment if needed
# RESEND_API_KEY=                      # uncomment for email

# === Frontend ==========================================================
NEXT_PUBLIC_API_URL=http://localhost:3000   # required; web-portal reads this
NEXT_TELEMETRY_DISABLED=1                   # default 1

# === Rate limiting =====================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100     # default 100; set higher for staging/prod
RATE_LIMIT_BURST=20                    # default 20

# === CORS ==============================================================
CORS_ORIGINS=http://localhost:3002     # comma-separated, * for dev only
