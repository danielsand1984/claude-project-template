# Web-portal env vars. NEXT_PUBLIC_* are exposed to the browser; the rest are server-only.

PORT=3002                                    # default 3002
NEXT_PUBLIC_API_URL=http://localhost:3000    # required; the BFF / API base URL
NEXT_TELEMETRY_DISABLED=1                    # default 1

# Auth (server-side only, for next-auth or similar)
# AUTH_SECRET=                               # required if using next-auth; openssl rand -hex 32
# AUTH_KEYCLOAK_ID=                          # optional, AUTH_MODE=oidc path
# AUTH_KEYCLOAK_SECRET=                      # optional
# AUTH_KEYCLOAK_ISSUER=                      # optional
