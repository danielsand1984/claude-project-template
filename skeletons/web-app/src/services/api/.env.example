# API-only env vars. The root .env.example is the source of truth; this
# file documents what specifically the API service reads.

# Service config
PORT=3000                              # required (default 3000)
NODE_ENV=development                   # development | production
LOG_LEVEL=info                         # debug | info | warn | error

# Persistence + queue
DATABASE_URL=postgres://{{PROJECT_NAME}}:{{PROJECT_NAME}}@localhost:5432/{{PROJECT_NAME}}    # required
DB_POOL_MAX=20                         # default 20
DB_IDLE_TIMEOUT_MS=30000                # default 30000
DB_STATEMENT_TIMEOUT_MS=30000           # default 30000

REDIS_URL=redis://localhost:6379       # required

# Auth
AUTH_MODE=dev                          # dev | oidc
OIDC_ISSUER_URL=                       # required if AUTH_MODE=oidc
OIDC_CLIENT_ID=                        # required if AUTH_MODE=oidc
OIDC_CLIENT_SECRET=                    # required if AUTH_MODE=oidc
JWT_PUBLIC_KEY=                        # optional, raw PEM or base64

# CORS
CORS_ORIGINS=http://localhost:3002     # comma-separated, no * in production

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100     # default 100
RATE_LIMIT_BURST=20                    # default 20

# External (only if used)
ANTHROPIC_API_KEY=                     # optional
